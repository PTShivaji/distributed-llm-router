# deploy.env: values for docker-compose.prod.yml (passed with --env-file). PLACEHOLDERS ONLY.
#
#   1. Copy OUTSIDE the repository, e.g. /etc/llm-router/deploy.env, then: chmod 600 (owner root).
#   2. Replace every <...>. Generate each secret separately, e.g.:
#        python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#      or:  openssl rand -base64 48 | tr -d '/+=\n' | cut -c1-48
#   3. docker compose -f docker-compose.prod.yml --env-file /etc/llm-router/deploy.env up -d
#
# Never commit the real file (.gitignore excludes *.env). Never put these values in any VITE_* variable.

# --- Public endpoint (edge proxy) ---
# Your DNS name pointing at this server. Caddy obtains the certificate automatically (ports 80 and 443 open).
# "localhost" makes Caddy use its local internal CA instead (local testing only).
LLMR_DOMAIN=<router.example.com>
HTTP_PORT=80
HTTPS_PORT=443

# --- API settings file (tokens, chat keys, budgets, providers); template: .env.production.example ---
LLMR_APP_ENV_FILE=/etc/llm-router/app.env

# --- Images (tag with the git commit you deploy; "local" builds from this checkout) ---
API_IMAGE=llm-router-api:<git-sha>
WEB_IMAGE=llm-router-web:<git-sha>
EDGE_IMAGE=llm-router-edge:<git-sha>
BACKUP_IMAGE=llm-router-backup:<git-sha>

# --- PostgreSQL ---
POSTGRES_DB=llm_router
# Bootstrap/admin (superuser): backups, restores, maintenance only. Never given to the API.
POSTGRES_ADMIN_USER=llmr_admin
POSTGRES_ADMIN_PASSWORD=<generate-random-password-min-16-chars>
# Least-privileged application role used by the API (owns only its schema). Must differ from the admin.
POSTGRES_APP_USER=llmr_app
POSTGRES_APP_PASSWORD=<generate-random-password-min-16-chars>
POSTGRES_APP_SCHEMA=llm_router

# --- Redis (requirepass; shared by Redis and the API) ---
REDIS_PASSWORD=<generate-random-password-min-16-chars>
# Keep below REDIS_MEM_LIMIT; policy is noeviction (writes fail instead of silently dropping keys).
REDIS_MAXMEMORY=384mb

# --- Network (change only if the subnet clashes with an existing Docker network) ---
EDGE_SUBNET=172.31.250.0/24
EDGE_PROXY_IP=172.31.250.10

# --- Backups (docker compose ... --profile tools run --rm backup) ---
# age PUBLIC key (age1...). Keep the matching private key OFF this server (password manager / offline).
BACKUP_AGE_RECIPIENT=<age1-public-key>
BACKUP_DIR=/var/backups/llm-router
BACKUP_RETENTION_DAYS=14
PREDEPLOY_RETENTION_DAYS=30
BACKUP_MIN_KEEP=7
# Memory-backed scratch space for the plaintext dump during a backup (must exceed the dump size).
BACKUP_TMPFS_SIZE=512m

# --- Resource limits (defaults fit a 2 vCPU / 4 GB VM) ---
API_CPUS=1.0
API_MEM_LIMIT=768m
REDIS_CPUS=0.5
REDIS_MEM_LIMIT=512m
POSTGRES_CPUS=1.0
POSTGRES_MEM_LIMIT=1g
WEB_CPUS=0.25
WEB_MEM_LIMIT=128m
EDGE_CPUS=0.5
EDGE_MEM_LIMIT=256m

# Static file server for the built React app (frontend image, internal port 8080, plain HTTP).
# It is only reachable on the internal "edge" network; TLS, security headers, CSP, compression,
# rate limits and the body limit are applied by the edge proxy (infrastructure/Caddyfile).
{
	admin off
	persist_config off
	auto_https off
}

:8080 {
	root * /srv

	# Vite emits content-hashed files under /assets/: cache them for a year. A missing asset is a 404,
	# never the SPA fallback (that would cache index.html as "immutable" JavaScript).
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else (index.html, favicon, client-side routes such as /chat): always revalidate,
	# and fall back to index.html so React Router can resolve deep links and browser refreshes.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

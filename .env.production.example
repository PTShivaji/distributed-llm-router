# app.env: PRODUCTION API settings (LLMR_APP_ENV_FILE in deploy.env). PLACEHOLDERS ONLY.
#
# 1. Copy OUTSIDE the repository, e.g. /etc/llm-router/app.env, then: chmod 600.
# 2. Replace every <...> value. Generate each secret separately with:
#      python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# 3. Start the whole stack (see DEPLOYMENT.md):
#      docker compose -f docker-compose.prod.yml --env-file /etc/llm-router/deploy.env up -d
#
# docker-compose.prod.yml sets the topology values itself and they OVERRIDE this file:
#   ENVIRONMENT=production, LLMR_DISABLE_ENV_FILE=1, HOST/PORT, POSTGRES_HOST/PORT/DB/USER/PASSWORD
#   (the least-privileged app role from deploy.env), REDIS_HOST/PORT/PASSWORD, TRUST_PROXY_HEADERS and
#   TRUSTED_PROXIES (the edge proxy only). Database and Redis secrets therefore live in deploy.env, not here.
#
# With ENVIRONMENT=production the API REFUSES TO START if a required secret is missing, too short,
# a placeholder, or the development default, and if unsafe switches are set (see README "Production
# checklist"). Error messages name the setting, never its value.
#
# Settings not listed here keep their defaults; .env.example lists every setting.
# Real provider calls and paid embeddings stay OFF in this template (mock mode).

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Secrets (REQUIRED; >= 32 characters, all different) ---
ADMIN_API_TOKEN=<generate-random-48-char-token>
OBSERVABILITY_API_TOKEN=<generate-random-48-char-token>
CLIENT_ID_HASH_KEY=<generate-random-48-char-key>

# --- Data services (connection details are injected by docker-compose.prod.yml) ---
REDIS_DB=0
REDIS_KEY_PREFIX=llmr:
DATABASE_ENABLED=true
DATABASE_AUTO_MIGRATE=true

# --- HTTP hardening ---
# Docs are off by default in production; leave unset.
# DOCS_ENABLED=false
# Same-origin deployment (the edge proxy serves the frontend and the API): no CORS needed.
CORS_ALLOWED_ORIGINS=[]
MAX_REQUEST_BODY_BYTES=1048576
SECURITY_HEADERS_ENABLED=true
# Served over HTTPS by the edge proxy:
HSTS_ENABLED=true

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
# Reject (503) instead of allowing unlimited traffic when Redis is unreachable
RATE_LIMIT_FAIL_OPEN=false

# --- Cache (approximate matching stays off; never allow the lexical embedder) ---
CACHE_ENABLED=true
CACHE_SEMANTIC_ENABLED=false
CACHE_SEMANTIC_ALLOW_LEXICAL=false
# Bounded cache memory (Redis runs with maxmemory 384mb + noeviction: a full Redis would make every
# chat request fail closed). Worst case for cached answers = CACHE_MAX_ENTRIES x CACHE_MAX_ENTRY_BYTES.
CACHE_MAX_ENTRIES=5000
CACHE_MAX_ENTRY_BYTES=32768
CACHE_CACHEABLE_MAX_OUTPUT_TOKENS=[256,512,1024,2048,4096]

# --- Embeddings ---
# local = free lexical embedder (exact-match caching only with the settings above).
EMBEDDING_PROVIDER=local
# Paid embeddings (EMBEDDING_PROVIDER=litellm + CACHE_SEMANTIC_ENABLED=true) make a PAID call on
# every exact-cache miss, reserved against the SAME budgets as chat. The app refuses to start
# unless ALLOW_REAL_PROVIDER_CALLS=true, BUDGET_DAILY_USD > 0, EMBEDDING_MODEL=<provider>/<model>
# with that provider's key, and verified pricing are all set (applies in mock mode too):
# EMBEDDING_MODEL=<provider>/<embedding-model>
# EMBEDDING_INPUT_COST_PER_MILLION=<verified USD per 1M input tokens>
# EMBEDDING_PRICING_SOURCE=https://<official pricing page>
# EMBEDDING_PRICING_VERIFIED_ON=<YYYY-MM-DD>
# EMBEDDING_PRICING_IS_PLACEHOLDER=false

# --- Persistence (raw text NOT stored) ---
PERSIST_PROMPTS=false
PERSIST_RESPONSES=false

# --- Observability ---
METRICS_ENABLED=true
TRACING_ENABLED=false
TRACING_TRUST_INCOMING=false

# --- Chat authentication (REQUIRED in production) ---
# Each client gets its own key; the NAME identifies it in rate limits, budgets and logs.
# Keys must differ from each other and from ADMIN_API_TOKEN / OBSERVABILITY_API_TOKEN.
CHAT_AUTH_MODE=api_key
# Rename "client-1" to your client name ([A-Za-z0-9._-], max 64 chars).
CHAT_API_KEYS={"client-1": "<generate-random-48-char-chat-key>"}

# --- Providers (real calls need BOTH switches + a budget + verified registry + keys) ---
# See backend/config/models.providers.example.json (verified IDs/pricing, all disabled). Mount the real
# registry read-only into the API containers and point MODEL_REGISTRY_FILE at it.
LLM_MOCK_MODE=true
ALLOW_REAL_PROVIDER_CALLS=false
# MODEL_REGISTRY_FILE=/etc/llm-router/models.json
# OPENAI_API_KEY=<provider-key>
# ANTHROPIC_API_KEY=<provider-key>
# GEMINI_API_KEY=<provider-key>
# GROQ_API_KEY=<provider-key>
# MISTRAL_API_KEY=<provider-key>

# --- Spend safeguards (UTC day, shared via Redis by chat AND paid embeddings; 0 = no limit) ---
# BUDGET_DAILY_USD is REQUIRED (> 0) before real provider calls or paid embeddings are allowed.
BUDGET_DAILY_USD=0
# Production warns when real calls are on without a per-client limit.
BUDGET_DAILY_USD_PER_CLIENT=0
BUDGET_DAILY_TOKENS_PER_CLIENT=0
# One chat request: its paid embedding + every attempt (retries and fallbacks).
BUDGET_MAX_COST_PER_REQUEST_USD=0
# Redis unreachable: reject paid chat calls (503). Paid embeddings are always refused then.
BUDGET_FAIL_CLOSED=true
REAL_MAX_OUTPUT_TOKENS=4096

# Copy to .env and adjust:   copy .env.example .env
# Lists EVERY setting with its development default (see backend/app/core/config.py).
# No API keys are required: LLM_MOCK_MODE=true serves every model from a free mock provider.
# Production template: .env.production.example

# --- Application ---
APP_NAME=Distributed LLM Router
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- Redis (matches docker-compose.yml) ---
# 127.0.0.1 (not "localhost"): Docker publishes on 127.0.0.1 only, and on Windows
# "localhost" resolves to ::1 first, which times out instead of failing over quickly.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- PostgreSQL (matches docker-compose.yml) ---
POSTGRES_HOST=127.0.0.1
# Host port published by Docker (5433 avoids clashing with a local PostgreSQL on 5432)
POSTGRES_PORT=5433
POSTGRES_USER=router
POSTGRES_PASSWORD=router_password
POSTGRES_DB=llm_router

# --- Query classifier (Phase 2) ---
# score < SIMPLE_THRESHOLD -> SIMPLE; score >= COMPLEX_THRESHOLD -> COMPLEX; else MEDIUM
CLASSIFIER_SIMPLE_THRESHOLD=0.28
CLASSIFIER_COMPLEX_THRESHOLD=0.55

# --- LLM routing (Phase 3) ---
# true = every model is served by the deterministic mock provider (no keys, no cost)
LLM_MOCK_MODE=true
# Empty = built-in mock registry. Example for real models (relative to project root):
# MODEL_REGISTRY_FILE=backend/config/models.json
MODEL_REGISTRY_FILE=
# priority | lowest_cost
ROUTING_STRATEGY=priority
ROUTING_TIER_ESCALATION=true

# --- Fallback & retries ---
FALLBACK_ENABLED=true
FALLBACK_AUTO_TIER=true
FALLBACK_ON_OVERRIDE=false
MAX_FALLBACK_MODELS=3
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_BACKOFF_SECONDS=0.25
DEFAULT_MAX_OUTPUT_TOKENS=1024
ESTIMATE_MISSING_USAGE=true

# --- Provider health (circuit breaker) ---
HEALTH_FAILURE_THRESHOLD=3
HEALTH_COOLDOWN_SECONDS=30

# --- Mock provider ---
MOCK_LATENCY_MS=0
# Simulate failures (JSON). Modes: timeout, unavailable, rate_limit, connection,
# auth, bad_request, content_policy, flaky.  Example:
# MOCK_FAILURES={"mock-advanced": "timeout"}
MOCK_FAILURES={}

# --- Provider API keys: used only for real chat calls (Phase 5 step 8) or paid embeddings
#     (EMBEDDING_PROVIDER=litellm, step 8A); both need ALLOW_REAL_PROVIDER_CALLS=true. ---
# Never commit real keys. .env is git-ignored.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# ======================= Phase 4: distributed infrastructure =======================
# --- Redis (one shared connection pool per instance) ---
REDIS_ENABLED=true
# Namespace for every key; use a different prefix per environment sharing one Redis.
REDIS_KEY_PREFIX=llmr:
REDIS_CONNECT_TIMEOUT_SECONDS=1.0
REDIS_SOCKET_TIMEOUT_SECONDS=1.0
REDIS_MAX_CONNECTIONS=50
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30

# --- Response cache (exact match + embedding similarity) ---
CACHE_ENABLED=true
# Approximate (similarity) hits. OFF by default: with the local lexical embedder,
# 14/16 meaning-changing edits (negations, numbers, dates, versions, entities)
# still scored >= 0.92. Exact-match caching works regardless. See README.
CACHE_SEMANTIC_ENABLED=false
# Allow approximate hits with the LOCAL LEXICAL embedder anyway (UNSAFE: changed
# entities / word order can be served a wrong cached answer). Leave false unless
# you have measured it on your own traffic. Not needed with EMBEDDING_PROVIDER=litellm.
CACHE_SEMANTIC_ALLOW_LEXICAL=false
CACHE_TTL_SECONDS=3600
# Cosine similarity needed for a semantic hit (only used when approximate hits are on).
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_MAX_ENTRIES_PER_SCOPE=1000
# Memory bound across ALL scopes and instances: at most CACHE_MAX_ENTRIES answers of at most
# CACHE_MAX_ENTRY_BYTES each (5000 x 32 KiB = 160 MiB). At the cap new answers are not cached
# until older ones expire; larger answers are never cached. Keep the product well below Redis maxmemory.
CACHE_MAX_ENTRIES=5000
CACHE_MAX_ENTRY_BYTES=32768
# Only these effective max_output_tokens values (plus each model's maximum and DEFAULT_MAX_OUTPUT_TOKENS)
# and temperatures on a 0.1 grid are cached; other requests are answered normally but skip the cache.
CACHE_CACHEABLE_MAX_OUTPUT_TOKENS=[256,512,1024,2048,4096]
CACHE_LOCK_TIMEOUT_SECONDS=30
CACHE_LOCK_WAIT_SECONDS=5

# --- Embeddings ---
# local = deterministic lexical hashing embedder (no keys); litellm = real embedding model
EMBEDDING_PROVIDER=local
# e.g. openai/text-embedding-3-small (needs the matching *_API_KEY)
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=256
EMBEDDING_TIMEOUT_SECONDS=10
# --- Paid embeddings (Phase 5 step 8A) ---
# EMBEDDING_PROVIDER=litellm makes a PAID call on every exact-cache miss. The app REFUSES TO START
# unless ALL of these hold (also in mock mode): ALLOW_REAL_PROVIDER_CALLS=true, BUDGET_DAILY_USD > 0,
# EMBEDDING_MODEL=<provider>/<model> with that provider's API key, and verified pricing below.
# Every call is reserved against the SAME daily/per-client/per-request budget as chat.
# Example (OpenAI text-embedding-3-small, $0.02 per 1M input tokens, verified 2026-11-09 at
# https://developers.openai.com/api/docs/pricing - re-check before use):
#   EMBEDDING_INPUT_COST_PER_MILLION=0.02
#   EMBEDDING_PRICING_SOURCE=https://developers.openai.com/api/docs/pricing
#   EMBEDDING_PRICING_VERIFIED_ON=2026-11-09
#   EMBEDDING_PRICING_IS_PLACEHOLDER=false
EMBEDDING_INPUT_COST_PER_MILLION=0
EMBEDDING_PRICING_SOURCE=
EMBEDDING_PRICING_IS_PLACEHOLDER=true

# --- Distributed provider health ---
# redis = shared by all instances; memory = process-local (Phase 3 behaviour)
HEALTH_BACKEND=redis
HEALTH_KEY_TTL_SECONDS=86400
HEALTH_PROBE_TTL_SECONDS=30

# --- Rate limiting (per client, shared across instances; 0 disables a window) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
# Redis down: true = allow requests, false = reject with 503
RATE_LIMIT_FAIL_OPEN=true
# Per-model requests/minute (JSON); over-limit models are skipped -> fallback
MODEL_RATE_LIMITS={}
# Only honour X-Forwarded-For when the direct peer is a listed proxy (JSON list of IPs/CIDRs)
TRUST_PROXY_HEADERS=false
TRUSTED_PROXIES=[]

# --- PostgreSQL persistence (request history + analytics) ---
DATABASE_ENABLED=true
DATABASE_AUTO_MIGRATE=true
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=3
# PostgreSQL unreachable (at startup or after repeated write failures): reconnect in the background,
# first after DATABASE_RECONNECT_INITIAL_SECONDS, doubling up to DATABASE_RECONNECT_MAX_SECONDS. No restart needed.
DATABASE_RECONNECT_INITIAL_SECONDS=1
DATABASE_RECONNECT_MAX_SECONDS=30
# Connection-level write failures retried per batch (with backoff) before waiting for the reconnect loop.
PERSISTENCE_WRITE_MAX_ATTEMPTS=3
# Raw prompt / answer text is NOT stored unless enabled (sensitive data)
PERSIST_PROMPTS=false
PERSIST_RESPONSES=false
PERSISTENCE_QUEUE_SIZE=1000

# --- Admin ---
# Bearer token for DELETE /api/v1/cache. Leave empty to disable admin endpoints.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=

# ======================= Phase 5: observability =======================
# --- Logging ---
# text (default, human-readable) | json (one JSON object per line)
LOG_FORMAT=text
# Structured http.request access log (client is hashed, never the raw IP)
ACCESS_LOG_ENABLED=true
# HMAC key for client identifiers in logs, rate-limit keys and DB rows.
# Empty = plain SHA-256 (reversible for IPv4 by brute force). REQUIRED in production.
CLIENT_ID_HASH_KEY=

# --- Prometheus metrics (GET /metrics) ---
METRICS_ENABLED=true
# Bearer token for /metrics, /api/v1/analytics/summary, /api/v1/cache/stats and
# /health/dependencies. Empty = open (development). REQUIRED in production.
OBSERVABILITY_API_TOKEN=

# --- OpenTelemetry tracing (disabled by default) ---
TRACING_ENABLED=false
# none | memory | console | otlp (otlp needs: pip install -r requirements-observability.txt)
TRACING_EXPORTER=none
TRACING_SERVICE_NAME=llm-router
TRACING_SAMPLE_RATIO=1.0
# Accept an incoming W3C traceparent as parent (only behind a trusted gateway)
TRACING_TRUST_INCOMING=false
# e.g. http://localhost:4318/v1/traces
# TRACING_OTLP_ENDPOINT=

# ======================= Phase 5 step 7: HTTP hardening =======================
# Interactive docs (/docs, /redoc, /openapi.json). Unset = on, except in production.
# DOCS_ENABLED=true
# Exact browser origins allowed for CORS (JSON list). Empty = no CORS headers at all.
CORS_ALLOWED_ORIGINS=[]
# Request body limit in bytes (enforced while streaming, also without Content-Length)
MAX_REQUEST_BODY_BYTES=1048576
SECURITY_HEADERS_ENABLED=true
# Strict-Transport-Security: enable ONLY when served over HTTPS
HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=31536000

# ======================= Phase 5 step 8: chat auth, real providers, spend limits =======================
# --- Chat authentication for POST /api/v1/chat ---
# none (development default) | api_key (REQUIRED in production)
CHAT_AUTH_MODE=none
# JSON {"client-name": "key"}; keys >= 16 chars (>= 32 in production), all distinct and
# different from ADMIN_API_TOKEN / OBSERVABILITY_API_TOKEN. Clients send
# "Authorization: Bearer <key>". Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CHAT_API_KEYS={}

# --- Real provider calls: double opt-in ---
# Real calls need LLM_MOCK_MODE=false AND ALLOW_REAL_PROVIDER_CALLS=true, plus BUDGET_DAILY_USD > 0,
# a registry with verified pricing (backend/config/models.providers.example.json) and the provider
# key of every enabled model. Otherwise the app REFUSES TO START (it never silently spends).
ALLOW_REAL_PROVIDER_CALLS=false

# --- Spend safeguards (UTC day, shared across instances via Redis; 0 = no limit) ---
BUDGET_DAILY_USD=0
BUDGET_DAILY_USD_PER_CLIENT=0
BUDGET_DAILY_TOKENS_PER_CLIENT=0
# Limit for ONE chat request (USD): its paid embedding + every attempt (retries and fallbacks),
# each counted at its worst case (prompt upper bound + max output) and corrected on settlement.
BUDGET_MAX_COST_PER_REQUEST_USD=0
# Budget store (Redis) unreachable: true = reject paid chat calls with 503, false = allow chat
# without limits. Paid embeddings are ALWAYS refused without a reservation (step 8A).
BUDGET_FAIL_CLOSED=true
# Upper bound for max_output_tokens on real provider calls
REAL_MAX_OUTPUT_TOKENS=4096

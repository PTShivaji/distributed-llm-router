# Copy to .env.local only if you need to change it. NEVER put tokens or API keys in any
# VITE_* variable: Vite embeds every VITE_* value into the JavaScript bundle shipped to browsers.
# Credentials (chat key, observability token, admin token) are entered at runtime in the UI.
#
# Empty (default) = same origin. In development the Vite dev server proxies /api, /health
# and /metrics to the FastAPI backend at http://127.0.0.1:8000, so no CORS setup is needed.
VITE_API_BASE_URL=
